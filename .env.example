# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
# DeepSeek API Key，用于 AI 问答页面调用模型
DEEPSEEK_API_KEY=sk-your-key-here
# 可选：服务地址与模型（默认如下）
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# 可选：教学行为与分析配置
# 行为事件保留天数（默认 365）
# TEACHING_EVENT_RETENTION_DAYS=365
# 教学建议缓存时长，毫秒（默认 10 分钟）
# TEACHING_REPORT_TTL_MS=600000
# 调用 DeepSeek 生成建议的超时，毫秒（默认 45000）
# TEACHING_LLM_TIMEOUT_MS=45000
# 是否记录测试场次汇总；设为 0 可快速关闭（默认 1）
# TEACHING_TRACKING=1
